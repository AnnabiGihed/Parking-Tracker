{
  "openapi": "3.0.4",
  "info": {
    "title": "Parking Tracker API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get the own account",
        "description": "Returns the account of the access token: its identifier, the day it was created, the last day the user signed in or refreshed, and the number of devices signed in. Nothing in the answer identifies the person. Limited per account: 120 requests per minute with a burst of 30.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Unauthorized",
                  "status": 401
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Delete the own account",
        "description": "Deletes the account and every device session in one transaction and records the hash of the Google subject in the erasure log, which only serves to apply the erasure again after a backup restore. It is no ban: the same Google account can sign in again and gets a new account. Idempotent: a repeated call with an access token that has not expired answers 204 as well. Access tokens already issued stay valid until they expire, but they name an account that no longer exists, so GET /me then answers 401. Limited per account: 120 requests per minute with a burst of 30.",
        "operationId": "deleteMe",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Unauthorized",
                  "status": 401
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Persistence.Concurrency",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "The data changed while it was being saved."
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/me/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get the own profile",
        "description": "Returns the profile document of the account (places, vehicle and residents' card), decrypted. The ETag header is the revision in quotes, for example \"3\". An If-None-Match that names the current revision (or *) answers 304 without a body. 404 when the account has no profile yet. A stored profile that cannot be decrypted answers 500 without a cause. Limited per account: 30 requests per minute with a burst of 10.",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDocument"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Unauthorized",
                  "status": 401
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Profile.NotFound",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "The account has no profile yet."
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Profile.Unreadable",
                  "title": "Internal Server Error",
                  "status": 500
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Store the own profile",
        "description": "Validates and stores the profile document, encrypted. The write must say what it is based on: If-Match with the revision in quotes (for example \"3\") to replace that revision, or If-None-Match: * to create the first profile; neither is 428, a malformed value or both together is 400, and a revision that is not the stored one, a create over an existing profile or a write that lost a race is 412 (read the profile again, merge, write again). The document has at most 32 KB of plain text and the body at most 40 KB (413 above), the schema version is 1, coordinates lie in the Brussels region, at most 50 favourite places. The answer carries the new revision in the body and in the ETag header. Limited per account: 30 requests per minute with a burst of 10.",
        "operationId": "putProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileDocument"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileDocument"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRevisionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {
                  "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
                  "title": "One or more validation errors occurred.",
                  "status": 400,
                  "errors": {
                    "IdToken": [
                      "The IdToken field is required."
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Unauthorized",
                  "status": 401
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Profile.PreconditionFailed",
                  "title": "Precondition Failed",
                  "status": 412,
                  "detail": "Read the profile again before writing."
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Request body too large",
                  "status": 413
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Profile.PreconditionRequired",
                  "title": "Precondition Required",
                  "status": 428,
                  "detail": "Send If-Match with the revision, or If-None-Match: * to create."
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/sessions/current": {
      "delete": {
        "tags": [
          "Sessions"
        ],
        "summary": "Sign out this device",
        "description": "Revokes the device session named in the access token (its sid claim): every refresh token of the device stops working, other devices are not affected. Idempotent: a session that is gone or already revoked answers 204 as well. Access tokens already issued stay valid until they expire (15 minutes); only the refresh is cut at once. Limited per account: 120 requests per minute with a burst of 30.",
        "operationId": "deleteCurrentSession",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Unauthorized",
                  "status": 401
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Persistence.Concurrency",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "The data changed while it was being saved."
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/sessions/challenges": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Create a sign-in challenge",
        "description": "Issues a random single-use nonce, valid for 5 minutes. The app passes it to Google (Android Credential Manager) so that the ID token it gets back is bound to this challenge. Expired nonces are purged on every call. Limited to 10 session requests per minute per client address.",
        "operationId": "createSignInChallenge",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInChallengeResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Sign in with a Google ID token",
        "description": "Validates the Google ID token (signature, issuer, audience, expiry), consumes the single-use nonce it carries, finds or creates the account of the Google subject and starts a device session. Returns the API access token (ES256 JWT, 15 minutes) and a single-use refresh token. Every refusal is the same 401 answer without a cause; the cause is only logged. A consumed nonce stays consumed even when the answer is a refusal. Limited to 10 session requests per minute per client address.",
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {
                  "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
                  "title": "One or more validation errors occurred.",
                  "status": 400,
                  "errors": {
                    "IdToken": [
                      "The IdToken field is required."
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Session.SignIn.Failed",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "The sign-in could not be completed."
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Request body too large",
                  "status": 413
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/refresh": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Refresh a session",
        "description": "Exchanges the single-use refresh token for a new access token (15 minutes) and the next refresh token; the presented token is spent. Presenting a token that was already exchanged revokes the whole family of the device, and the device must sign in again. An unknown, revoked or expired token (30 days unused, 90 days in all) is refused. Every refusal is the same 401 answer without a cause; the cause is only logged. Limited to 30 refresh requests per minute per client address, apart from the sign-in limit.",
        "operationId": "refreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {
                  "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
                  "title": "One or more validation errors occurred.",
                  "status": 400,
                  "errors": {
                    "IdToken": [
                      "The IdToken field is required."
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "type": "Session.Refresh.Failed",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "The session could not be refreshed."
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Request body too large",
                  "status": 413
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {
                  "title": "Too many requests",
                  "status": 429
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "required": [
          "idToken"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "example": {
          "idToken": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ij....<Google ID token>"
        }
      },
      "MeResponse": {
        "required": [
          "accountId",
          "activeSessionCount",
          "createdOn",
          "lastSeenOn"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "createdOn": {
            "type": "string",
            "format": "date"
          },
          "lastSeenOn": {
            "type": "string",
            "format": "date"
          },
          "activeSessionCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "example": {
          "accountId": "3f2c1e5a-7a52-4b8e-9d0e-0a5b1f6d9c11",
          "createdOn": "2026-11-20",
          "lastSeenOn": "2026-11-20",
          "activeSessionCount": 1
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {},
        "example": {
          "type": "Error.Code",
          "title": "Short title of the problem",
          "status": 400,
          "detail": "What went wrong, without private data."
        }
      },
      "ProfileCardSection": {
        "required": [
          "lims",
          "mailles",
          "municipality",
          "tolerances",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "municipality": {
            "type": "string"
          },
          "sector": {
            "type": "string",
            "nullable": true
          },
          "validFrom": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "validTo": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "tolerances": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mailles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "number": {
            "type": "string",
            "nullable": true
          },
          "plate": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ProfileClearedSections": {
        "type": "object",
        "properties": {
          "home": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "work": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "vehicle": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "card": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProfileDocument": {
        "required": [
          "favourites",
          "schemaVersion"
        ],
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "home": {
            "$ref": "#/components/schemas/ProfilePlaceSection"
          },
          "work": {
            "$ref": "#/components/schemas/ProfilePlaceSection"
          },
          "favourites": {
            "$ref": "#/components/schemas/ProfileFavouritesSection"
          },
          "vehicle": {
            "$ref": "#/components/schemas/ProfileVehicleSection"
          },
          "card": {
            "$ref": "#/components/schemas/ProfileCardSection"
          },
          "cleared": {
            "$ref": "#/components/schemas/ProfileClearedSections"
          }
        },
        "additionalProperties": false,
        "example": {
          "schemaVersion": 1,
          "home": {
            "label": "Home",
            "latitude": 50.8467,
            "longitude": 4.3525,
            "addressText": "Rue de la Loi 16, 1000 Bruxelles",
            "updatedAt": "2026-11-20T10:00:00+00:00"
          },
          "work": null,
          "favourites": {
            "updatedAt": "2026-11-20T10:00:00+00:00",
            "places": [
              {
                "label": "Gym",
                "latitude": 50.8503,
                "longitude": 4.3517,
                "addressText": null
              }
            ]
          },
          "vehicle": {
            "make": "renault",
            "model": "Zoe",
            "year": 2021,
            "fuel": "Electric",
            "euroNorm": "Unknown",
            "connectors": [
              "Type2",
              "Ccs"
            ],
            "batteryKwh": 52,
            "rangeKm": 300,
            "plate": null,
            "updatedAt": "2026-11-20T10:00:00+00:00"
          },
          "card": null,
          "cleared": {
            "work": "2026-11-20T09:00:00+00:00"
          }
        }
      },
      "ProfileFavouritePlace": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "addressText": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProfileFavouritesSection": {
        "required": [
          "places",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "places": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileFavouritePlace"
            }
          }
        },
        "additionalProperties": false
      },
      "ProfilePlaceSection": {
        "required": [
