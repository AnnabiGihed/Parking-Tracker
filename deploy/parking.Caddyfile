# BEGIN Parking Tracker (ADR-0028)
# provision.sh writes this block into the shared proxy's Caddyfile, between these two marker lines, and replaces it on
# a later run; deployments never edit it. The API forwards to its container on the shared `web` network; until that
# container runs, the site answers 503 over HTTPS with its own certificate. The admin app (S8) answers 503 until its
# stage. The apex serves the privacy notice at /privacy, redirects / to it and answers 404 elsewhere. The access log
# drops the query string, because a query can hold a bounding box.
# The API trusts X-Forwarded-* only on a request with the proxy key (ADR-0029): provision.sh replaces
# the proxy-key placeholder of the header_up line below with the key it holds in secrets/app/proxy_key when it writes
# the block, so the key is never committed (the comment does not repeat the placeholder, so the key lands only there).
# It likewise replaces the PT_PRIVACY_NOTICE_PLACEHOLDER line with deploy/site/privacy-notice.html
# (server/pt_caddy_block.py), braces escaped, and refuses a page that holds the heredoc marker PT_PRIVACY_NOTICE_END.
# The placeholder and the marker sit in column 0 because a heredoc body must carry its closing marker's indentation.

(parking_tracker_common) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	log {
		format filter {
			request>uri regexp \?.*$ ""
		}
	}
}

(parking_tracker_unavailable) {
	handle_errors 502 503 504 {
		respond "Parking Tracker: not deployed yet, or restarting." 503
	}
}

api.parking.pivotsoftwares.com {
	import parking_tracker_common
	request_body {
		max_size 256KB
	}
	handle /api/v1/admin/* {
		respond 404
	}
	handle {
		reverse_proxy parking-api:8080 {
			header_up X-PT-Proxy-Key PT_PROXY_KEY_PLACEHOLDER
		}
	}
	import parking_tracker_unavailable
}

admin.parking.pivotsoftwares.com {
	import parking_tracker_common
	respond "Parking Tracker administration: not available yet." 503
}

parking.pivotsoftwares.com {
	import parking_tracker_common
	handle /privacy {
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		header Content-Type "text/html; charset=utf-8"
		respond <<PT_PRIVACY_NOTICE_END
PT_PRIVACY_NOTICE_PLACEHOLDER
PT_PRIVACY_NOTICE_END 200
	}
	handle / {
		redir * /privacy 302
	}
	handle {
		respond 404
	}
}
# END Parking Tracker (ADR-0028)
