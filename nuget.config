<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-pivot" value="https://nuget.pkg.github.com/AnnabiGihed/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="github-pivot">
      <package pattern="Pivot.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Credentials come from the environment only; NuGet expands the variables at read time. -->
  <packageSourceCredentials>
    <github-pivot>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-pivot>
  </packageSourceCredentials>
</configuration>
