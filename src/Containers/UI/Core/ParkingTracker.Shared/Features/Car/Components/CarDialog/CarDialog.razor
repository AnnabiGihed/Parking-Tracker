@namespace ParkingTracker.Shared.Features.Car.Components
@inherits ViewModelComponent<CarViewModel>
<DialogShell IsOpen="ViewModel.IsOpen" Label="My car">
    <RadzenStack Gap="0.75rem" class="dialog-form" id="carForm">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="dialog-head">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">My car</RadzenText>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="icon-btn" aria-label="Close" Click="OnClose"><Icon Name="close" /></RadzenButton>
        </RadzenStack>
        <RadzenText id="carInfo" TextStyle="TextStyle.Body2" TagName="TagName.Div" class="muted">
            @ViewModel.Info
            @if (!string.IsNullOrEmpty(ViewModel.AppSaid))
            {
                <br /><text>The app said: </text><b>@ViewModel.AppSaid</b>
            }
        </RadzenText>
        <RadzenStack Gap="0.5rem" id="carActions">
            @if (ViewModel.Car is not null)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn-block" Style="width:100%" Click="OnWalkAsync"><Icon Name="walk" />Walk to my car</RadzenButton>
                <div class="grid2">
                    <RadzenButton id="carShow" ButtonStyle="ButtonStyle.Light" Style="width:100%" Click="OnShow"><Icon Name="pin" />Show on map</RadzenButton>
                    <RadzenButton id="carHere" ButtonStyle="ButtonStyle.Light" Style="width:100%" Click="OnSaveHereAsync"><Icon Name="locate" />Car is here now</RadzenButton>
                </div>
                <RadzenButton id="carClear" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="btn-block" Style="width:100%" Click="OnForgetAsync">I left — forget this spot</RadzenButton>
            }
            else
            {
                <RadzenButton id="carHere" ButtonStyle="ButtonStyle.Primary" class="btn-block" Style="width:100%" Click="OnSaveHereAsync"><Icon Name="car" />My car is parked here</RadzenButton>
            }
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="card-box">
            <RadzenSwitch id="alertsToggle" aria-label="Parking alerts" Value="ViewModel.AlertsEnabled" ValueChanged="OnAlertsChangedAsync" />
            <span><b>Parking alerts</b><small class="muted small" style="display:block">When you park, the app checks the spot and notifies you if it's free or paid — even when it isn't open. Needs location “all the time”.</small></span>
        </RadzenStack>
        <div class="card-box">
            <div class="card-box-title"><Icon Name="timer" /><b>Parking timer</b></div>
            <div class="presets" id="timerPresets">
                @foreach (var preset in CarViewModel.Presets)
                {
                    var minutes = preset;
                    <RadzenButton data-min="@minutes" ButtonStyle="ButtonStyle.Primary" Variant="@(ViewModel.Minutes == minutes ? Variant.Filled : Variant.Outlined)" class="@(ViewModel.Minutes == minutes ? "on" : string.Empty)" Click="() => OnPreset(minutes)">@TimerText.Length(minutes)</RadzenButton>
                }
            </div>
            <div class="grid2">
                <RadzenStack Gap="0.3rem" class="field">
                    <RadzenLabel Text="Or minutes" Component="timerMinutes" />
                    <RadzenNumeric TValue="int?" Name="timerMinutes" id="timerMinutes" Min="5" Max="1440" Step="5" Style="width:100%" Value="ViewModel.Minutes" ValueChanged="OnMinutesChanged" />
                </RadzenStack>
                <div class="field end"><RadzenButton id="timerStart" ButtonStyle="ButtonStyle.Primary" Click="OnStartAsync">Start</RadzenButton></div>
            </div>
            @if (ViewModel.Timer is not null)
            {
                <RadzenButton id="timerStop" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="btn-block" Style="width:100%" Click="OnStopAsync">Stop the timer</RadzenButton>
            }
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">Reminder 10 minutes before the end, and at the end.</RadzenText>
        </div>
    </RadzenStack>
</DialogShell>
