@namespace ParkingTracker.Shared.Features.SpotCheck.Components
@inherits ViewModelComponent<NearestSpotViewModel>
<RadzenCard Variant="Variant.Outlined" id="nearest" class="@BlockClass">
    @switch (ViewModel.State)
    {
        case NearestSpotState.Loading:
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" class="spot-loading"><span class="spinner"></span>Looking for the nearest spot your card covers…</RadzenStack>
            break;
        case NearestSpotState.Failed:
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="spot-loading">@ViewModel.FailureMessage</RadzenText>
            break;
        case NearestSpotState.NoneFound:
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="spot-loading">No spot covered by your card within ~400 m right now.</RadzenText>
            break;
        case NearestSpotState.Found:
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" class="spot-head">
                <div class="spot-icon"><Icon Name="parking" /></div>
                <div>
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Div" class="spot-title">@ViewModel.Best!.Label</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="spot-sub">@ViewModel.BestSubtitle</RadzenText>
                </div>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" class="nav-row">
                <RadzenButton ButtonStyle="ButtonStyle.Base" class="btn-waze" Click="OnWazeAsync"><Icon Name="navigation" />Waze</RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Base" class="btn-gmaps" Click="OnGoogleMapsAsync"><Icon Name="directions" />Google Maps</RadzenButton>
            </RadzenStack>
            @if (ViewModel.Others.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="spot-more">@ViewModel.OthersText</RadzenText>
            }
            break;
    }
</RadzenCard>
