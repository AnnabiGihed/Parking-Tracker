@namespace ParkingTracker.Shared.Features.SpotCheck.Components
@inherits ViewModelComponent<LocationPermissionViewModel>
<RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="false" AllowClose="false" id="permBanner" class="@BannerClass">
    @if (ViewModel.Banner == PermissionBannerKind.TurnOn)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px">
            <Icon Name="locate" />
            <div class="grow"><b>Location is off.</b> The app needs your position to check where you park.</div>
            <div class="btns"><RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn-primary" Click="OnTurnOnAsync">Turn on</RadzenButton></div>
        </RadzenStack>
    }
    else if (ViewModel.Banner == PermissionBannerKind.AllowAlways)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px">
            <Icon Name="locate" />
            <div class="grow">For the best results, allow location <b>all the time</b>.</div>
            <div class="btns">
                <RadzenButton ButtonStyle="ButtonStyle.Primary" class="btn-primary" Click="OnAllowAsync">Allow</RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="btn-ghost" Click="OnLaterAsync">Later</RadzenButton>
            </div>
        </RadzenStack>
    }
</RadzenAlert>
