@namespace ParkingTracker.Shared.Features.SpotCheck.Components
@inherits ViewModelComponent<SearchViewModel>
<form id="searchForm" class="searchbar" role="search" @onsubmit="OnSubmitAsync" @onsubmit:preventDefault>
    <span class="searchbar-logo"><Icon Name="parking" /></span>
    <RadzenTextBox id="searchInput" type="search" Placeholder="Search a street or address" autocomplete="off" enterkeyhint="search"
                   @bind-Value="ViewModel.Text" Immediate="true" />
    <CardButton />
</form>
