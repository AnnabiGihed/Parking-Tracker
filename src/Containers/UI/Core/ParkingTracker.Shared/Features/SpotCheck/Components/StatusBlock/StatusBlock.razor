@namespace ParkingTracker.Shared.Features.SpotCheck.Components
@inherits ViewModelComponent<SpotCheckViewModel>
@{
    var status = ViewModel.Status;
}
<RadzenCard Variant="Variant.Flat" id="status" class="@BlockClass(status)">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="14px" class="hero">
        <div class="hero-icon"><Icon Name="@status.IconName" /></div>
        <div class="hero-text">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Div" class="hero-title">@status.Title</RadzenText>
            @if (status.IsIdle)
            {
                <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="hero-sub">Tap the map, search a street, or press <b>my location</b>. I'll tell you if your residents' card covers it.</RadzenText>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="hero-sub">@status.Detail</RadzenText>
            }
        </div>
    </RadzenStack>
    @if (status.Tariff is not null)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="8px" class="tariff"><Icon Name="euro" /><span>@status.Tariff</span></RadzenStack>
    }
    @if (status.Notes.Count > 0)
    {
        <ul class="notes">
            @foreach (var note in status.Notes)
            {
                <li><span>@note</span></li>
            }
        </ul>
    }
    @if (status.ShowParkedHere || status.ShowPayApps)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="8px" class="actions">
            @if (status.ShowParkedHere)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="btn-primary" Click="OnParkedHereAsync"><Icon Name="car" />I parked here</RadzenButton>
            }
            @if (status.ShowPayApps)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap="6px" class="paylinks">
                    Pay with
                    @foreach (var app in NavigationLinks.PayApps)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="() => OnPayAppAsync(app)">@app.Name</RadzenButton>
                    }
                </RadzenStack>
            }
        </RadzenStack>
    }
</RadzenCard>
