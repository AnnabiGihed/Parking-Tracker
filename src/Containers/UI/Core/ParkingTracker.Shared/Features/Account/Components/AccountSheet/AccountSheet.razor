@namespace ParkingTracker.Shared.Features.Account.Components
@inherits ViewModelComponent<AccountViewModel>
@using ParkingTracker.Shared.Features.Shared.Dialogs
<DialogBridge ViewModel="ViewModel" Title="Account">
    <div id="accountSheet" class="account-sheet">
        @if (!string.IsNullOrEmpty(ViewModel.Error))
        {
            <RadzenAlert id="accountError" AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" ShowIcon="false" role="alert">@ViewModel.Error</RadzenAlert>
        }
        @if (!ViewModel.IsSignedIn)
        {
            <p class="account-note">Developer build: sign in with Google against the API.</p>
            <RadzenButton id="accountSignIn" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Text="Sign in with Google" Disabled="ViewModel.IsBusy" Click="OnSignInAsync" />
            @if (ViewModel.IsConfirmingLocalRemoval)
            {
                <p id="accountLocalRemovalNote" class="account-note">@AccountViewModel.LocalRemovalNoteText</p>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="account-actions">
                    <RadzenButton id="accountKeepOnPhone" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Text="Keep on this phone" Disabled="ViewModel.IsBusy" Click="OnKeepOnPhone" />
                    <RadzenButton id="accountRemoveFromPhone" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Text="Remove from this phone" Disabled="ViewModel.IsBusy" Click="OnConfirmLocalRemovalAsync" Style="flex:1" />
                </RadzenStack>
            }
            @if (ViewModel.IsWipePending)
            {
                <RadzenButton id="accountWipeRetry" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Remove data from this phone" Disabled="ViewModel.IsBusy" Click="OnRetryWipeAsync" />
            }
        }
        else
        {
            @if (ViewModel.Account is not null)
            {
                <dl class="account-details">
                    <dt>Account</dt>
                    <dd id="accountId">@ViewModel.AccountIdText</dd>
                    <dt>Created on</dt>
                    <dd id="accountCreated">@ViewModel.CreatedText</dd>
                    <dt>Last seen on</dt>
                    <dd id="accountLastSeen">@ViewModel.LastSeenText</dd>
                    <dt>Active sessions</dt>
                    <dd id="accountSessions">@ViewModel.ActiveSessionsText</dd>
                </dl>
            }
            @if (ViewModel.IsConfirmingOwnerChange)
            {
                <p id="accountOwnerChangeNote" class="account-note">This phone holds the places, vehicle and card of another account. Remove them to continue with this account?</p>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="account-actions">
                    <RadzenButton id="accountOwnerChangeCancel" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Text="Cancel" Disabled="ViewModel.IsBusy" Click="OnCancelOwnerChangeAsync" />
                    <RadzenButton id="accountOwnerChangeConfirm" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Text="Remove and continue" Disabled="ViewModel.IsBusy" Click="OnConfirmOwnerChangeAsync" Style="flex:1" />
                </RadzenStack>
            }
            else if (ViewModel.IsConfirmingSignOut)
            {
                <p id="accountSignOutNote" class="account-note">Your latest changes are not saved to your account yet. If you sign out now they are removed from this phone.</p>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="account-actions">
                    <RadzenButton id="accountSignOutStay" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Text="Stay signed in" Disabled="ViewModel.IsBusy" Click="OnCancelSignOut" />
                    <RadzenButton id="accountSignOutAnyway" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Text="Sign out anyway" Disabled="ViewModel.IsBusy" Click="OnConfirmSignOutAsync" Style="flex:1" />
                </RadzenStack>
            }
            else if (ViewModel.IsConfirmingDelete)
            {
                <p class="account-note">This deletes your account on the server, removes its data from this phone and signs this phone out.</p>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="account-actions">
                    <RadzenButton id="accountDeleteCancel" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Text="Keep account" Disabled="ViewModel.IsBusy" Click="OnCancelDelete" />
                    <RadzenButton id="accountDeleteConfirm" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Text="Delete for good" Disabled="ViewModel.IsBusy" Click="OnConfirmDeleteAsync" Style="flex:1" />
                </RadzenStack>
            }
            else
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="account-actions">
                    <RadzenButton id="accountSignOut" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Sign out" Disabled="ViewModel.IsBusy" Click="OnSignOutAsync" />
                    <RadzenButton id="accountDelete" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Delete account" Disabled="ViewModel.IsBusy" Click="OnDelete" />
                </RadzenStack>
            }
        }
    </div>
</DialogBridge>
