@namespace ParkingTracker.Shared.Features.Places.Components
@inherits ViewModelComponent<PlacesViewModel>
<div class="place-chips" role="group" aria-label="Saved places">
    <RadzenChip id="placeHome" ChipStyle="BadgeStyle.Base" Size="ChipSize.Medium" class="place-go" Click="OnGoHomeAsync"><span class="place-label"><Icon Name="home" /><span>@(ViewModel.Home is null ? "Set home" : "Home")</span></span></RadzenChip>
    <RadzenChip id="placeWork" ChipStyle="BadgeStyle.Base" Size="ChipSize.Medium" class="place-go" Click="OnGoWorkAsync"><span class="place-label"><Icon Name="work" /><span>@(ViewModel.Work is null ? "Set work" : "Work")</span></span></RadzenChip>
</div>
