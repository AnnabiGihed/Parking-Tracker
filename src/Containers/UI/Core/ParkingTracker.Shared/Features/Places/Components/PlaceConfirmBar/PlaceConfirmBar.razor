@namespace ParkingTracker.Shared.Features.Places.Components
@inherits ViewModelComponent<PlacePickerViewModel>
@if (ViewModel.IsConfirmShown)
{
    <section id="placeConfirm" class="place-confirm" aria-live="polite">
        <div class="place-confirm-place">
            <Icon Name="pin" />
            <div class="place-confirm-text">
                <strong id="placeConfirmLabel" class="place-confirm-label">@ViewModel.CandidateLabel</strong>
                <span class="place-confirm-hint">@PlacePickerViewModel.DragHint</span>
                @if (ViewModel.IsOutsideBrussels)
                {
                    <span id="placeConfirmError" class="place-confirm-error" role="alert">@OutsideText</span>
                }
            </div>
        </div>
        @if (ViewModel.IsFavourite)
        {
            <div class="place-confirm-name">
                <RadzenLabel Text="Name" Component="placeName" />
                <RadzenTextBox Name="placeName" id="placeName" Value="@ViewModel.FavouriteName" ValueChanged="OnNameChanged" Immediate="true" MaxLength="PlacePickerViewModel.MaxNameLength"
                               Placeholder="For example Bakery" autocomplete="off" Disabled="ViewModel.State == PlacePickerState.Saving" Style="width:100%" />
                @if (!ViewModel.HasName)
                {
                    <span id="placeNameError" class="place-confirm-error" role="alert">Give the favourite a name.</span>
                }
            </div>
        }
        <div class="place-confirm-actions">
            @if (ViewModel.HasSavedPlace)
            {
                <RadzenButton id="placeRemove" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Text="Remove" Click="OnRemoveAsync" />
            }
            <RadzenButton id="placeCancel" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" class="place-cancel" Text="Cancel" Click="OnCancel" />
            <RadzenButton id="placeSave" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Text="Save" Disabled="!ViewModel.CanSave" Click="OnSaveAsync" />
        </div>
    </section>
}
