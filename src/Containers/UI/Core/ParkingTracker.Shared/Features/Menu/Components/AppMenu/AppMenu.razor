@namespace ParkingTracker.Shared.Features.Menu.Components
@inherits ViewModelComponent<MenuViewModel>
<div id="appMenu" class="app-menu">
    <header class="app-menu-head">
        <span class="app-menu-logo"><Icon Name="parking" /></span>
        <span class="app-menu-name">Parking Tracker</span>
    </header>
    @if (ViewModel.IsAccountVisible)
    {
        <RadzenPanelMenu class="app-menu-account" AriaLabel="Account">
            <RadzenPanelMenuItem id="menuAccount" Click="OnAccountAsync">
                <Template>
                    <span class="app-menu-item"><Icon Name="person" /><span class="app-menu-text"><span class="app-menu-title">@ViewModel.AccountTitle</span><span id="menuAccountText" class="app-menu-sub">@ViewModel.AccountText</span></span></span>
                </Template>
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
        @if (ViewModel.IsSyncVisible)
        {
            <p id="menuSyncText" class="app-menu-sync">@ViewModel.SyncText</p>
        }
    }
    <div id="menuSectionLabel" class="app-menu-section">@ViewModel.SectionLabel</div>
    <RadzenPanelMenu class="app-menu-items" AriaLabel="Menu">
        <RadzenPanelMenuItem id="menuHome" Click="OnHomeAsync">
            <Template>
                <span class="app-menu-item"><Icon Name="home" /><span class="app-menu-text"><span class="app-menu-title">Home</span><span class="app-menu-sub">@ViewModel.HomeText</span></span></span>
            </Template>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem id="menuWork" Click="OnWorkAsync">
            <Template>
                <span class="app-menu-item"><Icon Name="work" /><span class="app-menu-text"><span class="app-menu-title">Work</span><span class="app-menu-sub">@ViewModel.WorkText</span></span></span>
            </Template>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem id="menuFavourites" Click="OnFavouritesAsync">
            <Template>
                <span class="app-menu-item"><Icon Name="star" /><span class="app-menu-text"><span class="app-menu-title">Favourite places</span><span class="app-menu-sub">@ViewModel.FavouritesText</span></span></span>
            </Template>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem id="menuVehicle" Click="OnVehicleAsync">
            <Template>
                <span class="app-menu-item"><Icon Name="car" /><span class="app-menu-text"><span class="app-menu-title">My vehicle</span><span class="app-menu-sub">@ViewModel.VehicleText</span></span></span>
            </Template>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem id="menuCard" Click="OnCardAsync">
            <Template>
                <span class="app-menu-item"><Icon Name="card" /><span class="app-menu-text"><span class="app-menu-title">Parking card</span><span class="app-menu-sub">@ViewModel.CardText</span></span></span>
            </Template>
        </RadzenPanelMenuItem>
    </RadzenPanelMenu>
    @if (ViewModel.IsAccountVisible && ViewModel.IsSignedIn)
    {
        <RadzenPanelMenu class="app-menu-items app-menu-foot" AriaLabel="Account actions">
            <RadzenPanelMenuItem id="menuSignOut" Click="OnSignOutAsync">
                <Template>
                    <span class="app-menu-item"><Icon Name="logout" /><span class="app-menu-text"><span class="app-menu-title">Sign out</span></span></span>
                </Template>
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem id="menuDeleteAccount" Click="OnDeleteAccountAsync">
                <Template>
                    <span class="app-menu-item app-menu-danger"><Icon Name="delete" /><span class="app-menu-text"><span class="app-menu-title">Delete account</span></span></span>
                </Template>
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
        @if (!string.IsNullOrEmpty(ViewModel.AccountError))
        {
            <p id="menuAccountError" class="app-menu-error" role="alert">@ViewModel.AccountError</p>
        }
    }
</div>
