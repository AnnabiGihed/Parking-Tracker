@namespace ParkingTracker.Shared.Features.Welcome.Components
@inherits ViewModelComponent<WelcomeViewModel>
<DialogShell IsOpen="ViewModel.IsOpen" Label="Welcome">
    <RadzenStack class="welcome" id="welcomeDialog" Gap="0.75rem">
        <div class="welcome-logo"><Icon Name="parking" /></div>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="welcome-title">Park free with your residents' card</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" class="muted">Parking Tracker checks, live, whether your Brussels <em>carte riverain</em> covers the spot where you are.</RadzenText>
        <RadzenStack class="benefits" Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <span class="benefit-icon"><Icon Name="check" /></span>
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span"><b>Free or pay?</b> A clear answer for the spot you're on, in a second.</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <span class="benefit-icon"><Icon Name="directions" /></span>
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span"><b>Nearest free spot</b>, with Waze or Google Maps.</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <span class="benefit-icon"><Icon Name="block" /></span>
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span"><b>No bad surprises:</b> delivery bays, disabled spaces and roadworks.</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem">
                <span class="benefit-icon"><Icon Name="timer" /></span>
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span"><b>Find your car</b> and get a reminder before paid time ends.</RadzenText>
            </RadzenStack>
        </RadzenStack>
        <RadzenCard class="perm-box" Variant="Variant.Outlined">
            <RadzenStack Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="perm-title">
                    <Icon Name="locate" />
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span"><b>Location: choose “Allow all the time”</b></RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">
                    The app needs your position to check the spot where you park. For it to work best, allow location
                    <b>all the time</b>: Android first asks “While using the app”, then lets you pick “Allow all the time” in the app's location settings.
                </RadzenText>
                @if (ViewModel.Permission.ShowAllowAlwaysButton)
                {
                    <RadzenButton id="welcomeAlways" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" class="welcome-button" Click="OnAllowAlwaysAsync" Text="Allow location all the time" />
                }
                <RadzenText id="welcomePermState" TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">@ViewModel.Permission.WelcomeMessage</RadzenText>
            </RadzenStack>
        </RadzenCard>
        <RadzenButton id="welcomeStart" ButtonStyle="ButtonStyle.Primary" class="welcome-button" Click="OnAddCardAsync" Text="Add my parking card" />
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">Uses official live data from parking.brussels, Brussels Mobility and the City of Brussels. Your card stays on this phone.</RadzenText>
    </RadzenStack>
</DialogShell>
