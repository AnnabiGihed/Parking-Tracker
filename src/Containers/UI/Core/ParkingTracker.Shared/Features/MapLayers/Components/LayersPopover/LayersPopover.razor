@namespace ParkingTracker.Shared.Features.MapLayers.Components
@inherits ViewModelComponent<MapLayersViewModel>
<RadzenStack Gap="0.6rem" id="layersPanel" class="@PanelClass" role="dialog" aria-label="Map layers">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="popover-head">
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.Div" class="popover-title">Map layers</RadzenText>
        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="icon-btn" aria-label="Close" Click="OnClose"><Icon Name="close" /></RadzenButton>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="switch">
        <RadzenSwitch data-layer="streets" aria-label="Where my card works" Value="ViewModel.Switches.Streets" ValueChanged="@(isOn => OnToggleAsync("streets", isOn))" />
        <span><b>Where my card works</b><small>Zoomed out: official zone colours. Closer: green = free with your card, red = pay</small></span>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="switch">
        <RadzenSwitch data-layer="spaces" aria-label="Parking spaces" Value="ViewModel.Switches.Spaces" ValueChanged="@(isOn => OnToggleAsync("spaces", isOn))" />
        <span><b>Parking spaces</b><small>Delivery, disabled, taxi, EV… (street level)</small></span>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="switch">
        <RadzenSwitch data-layer="works" aria-label="Roadworks and events" Value="ViewModel.Switches.Works" ValueChanged="@(isOn => OnToggleAsync("works", isOn))" />
        <span><b>Roadworks &amp; events</b><small>May block parking</small></span>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="switch">
        <RadzenSwitch data-layer="carparks" aria-label="Car parks" Value="ViewModel.Switches.CarParks" ValueChanged="@(isOn => OnToggleAsync("carparks", isOn))" />
        <span><b>Car parks</b><small>Public underground parkings</small></span>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="switch">
        <RadzenSwitch data-layer="chargers" aria-label="EV charging" Value="ViewModel.Switches.Chargers" ValueChanged="@(isOn => OnToggleAsync("chargers", isOn))" />
        <span><b>EV charging</b><small>Charging points</small></span>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.4rem 0.75rem" class="legend-row">
        <span><i class="lg-free"></i>Free for you</span><span><i class="lg-check"></i>Check number</span>
        <span><i class="lg-pay"></i>Pay</span><span><i class="lg-red"></i>Red zone</span>
        <span><i class="lg-disc"></i>Disc</span><span><i class="lg-all"></i>Free for all</span>
        <span><i class="lg-now"></i>Free right now</span>
    </RadzenStack>
    <RadzenText id="layerState" TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">@ViewModel.StatusText</RadzenText>
</RadzenStack>
