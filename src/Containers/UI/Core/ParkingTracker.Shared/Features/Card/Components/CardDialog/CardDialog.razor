@namespace ParkingTracker.Shared.Features.Card.Components
@inherits ViewModelComponent<CardViewModel>
@using ParkingTracker.Domain.Features.Sectors.ValueObjects
<DialogShell IsOpen="ViewModel.IsOpen" Label="My parking card">
    <RadzenTemplateForm TItem="CardViewModel" Data="ViewModel" Submit="OnSaveAsync" id="cardForm">
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="dialog-head">
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">My parking card</RadzenText>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="icon-btn" aria-label="Close" Click="OnClose"><Icon Name="close" /></RadzenButton>
            </RadzenStack>
            <RadzenButton id="scanBtn" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" class="scan" Disabled="ViewModel.IsScanning" Click="OnScanAsync">
                <Icon Name="camera" />
                <span><b>Scan my card</b><small>Take a photo, we fill in the fields</small></span>
                @if (ViewModel.IsScanning)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                }
            </RadzenButton>
            <RadzenText id="scanStatus" TextStyle="TextStyle.Body2" TagName="TagName.Div" class="muted small" role="status">@ViewModel.ScanStatus</RadzenText>
            <RadzenStack Gap="0.3rem" class="field">
                <RadzenLabel Text="Municipality that issued the card" Component="muniSelect" />
                <RadzenDropDown TValue="string" Name="muniSelect" id="muniSelect" Style="width:100%" Data="MunicipalityOptions" TextProperty="Value" ValueProperty="Key"
                                Value="ViewModel.MunicipalityId" ValueChanged="OnMunicipalityChangedAsync" AllowClear="false" />
            </RadzenStack>
            <div id="sectorBox">
                @switch (ViewModel.SelectedMunicipality?.Kind)
                {
                    case MunicipalityKind.Streets:
                        <RadzenStack Gap="0.3rem" class="field">
                            <RadzenLabel Text="Sector (on your card)" Component="sectorSelect" />
                            <RadzenDropDown TValue="string" Name="sectorSelect" id="sectorSelect" Style="width:100%" Data="SectorOptions" TextProperty="Value" ValueProperty="Key"
                                            Value="ViewModel.SectorId" ValueChanged="OnSectorChanged" AllowClear="false" />
                        </RadzenStack>
                        break;
                    case MunicipalityKind.Mailles:
                        @switch (ViewModel.MailleState)
                        {
                            case MailleLoadState.Loading:
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="muted small">Loading the areas from parking.brussels…</RadzenText>
                                </RadzenStack>
                                break;
                            case MailleLoadState.Failed:
                                <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">@ViewModel.MailleError</RadzenText>
                                break;
                            case MailleLoadState.Loaded:
                                <RadzenStack Gap="0.5rem">
                                    <RadzenLabel Text="Areas on your card" />
                                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">Tick every area (secteur / maille / zone) printed on your card.</RadzenText>
                                    <RadzenCheckBoxList TValue="string" id="maillesBox" Orientation="Orientation.Vertical" Value="ViewModel.SelectedMailles" ValueChanged="OnMaillesChanged">
                                        <Items>
                                            @foreach (var area in ViewModel.Mailles!.Areas)
                                            {
                                                <RadzenCheckBoxListItem TValue="string" Value="area.ZoneCode" Text="@area.DisplayName">
                                                    <Template Context="box"><b>@area.DisplayName</b> <small>@area.ZoneCode</small></Template>
                                                </RadzenCheckBoxListItem>
                                            }
                                        </Items>
                                    </RadzenCheckBoxList>
                                    @if (ViewModel.Mailles!.BorderZones.Count > 0)
                                    {
                                        <RadzenLabel Text="Border zones" />
                                        <RadzenCheckBoxList TValue="string" id="limsBox" Orientation="Orientation.Vertical" Value="ViewModel.SelectedLims" ValueChanged="OnLimsChanged">
                                            <Items>
                                                @foreach (var zone in ViewModel.Mailles!.BorderZones)
                                                {
                                                    <RadzenCheckBoxListItem TValue="string" Value="zone.ZoneCode" Text="@zone.DisplayName">
                                                        <Template Context="box"><b>@zone.DisplayName</b> <small>@zone.ZoneCode</small></Template>
                                                    </RadzenCheckBoxListItem>
                                                }
                                            </Items>
                                        </RadzenCheckBoxList>
                                    }
                                </RadzenStack>
                                break;
                        }
                        break;
                    default:
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">@ViewModel.SelectedMunicipality?.Note</RadzenText>
                        break;
                }
            </div>
            <div class="grid2">
                <RadzenStack Gap="0.3rem" class="field">
                    <RadzenLabel Text="Valid from" Component="cardFrom" />
                    <RadzenDatePicker TValue="DateTime?" Name="cardFrom" Style="width:100%" DateFormat="@DisplayDateFormat" AllowInput="false" Value="ParseDate(ViewModel.ValidFrom)" ValueChanged="OnValidFromChanged" AllowClear="true" />
                </RadzenStack>
                <RadzenStack Gap="0.3rem" class="field">
                    <RadzenLabel Text="Valid until" Component="cardTo" />
                    <RadzenDatePicker TValue="DateTime?" Name="cardTo" Style="width:100%" DateFormat="@DisplayDateFormat" AllowInput="false" Value="ParseDate(ViewModel.ValidTo)" ValueChanged="OnValidToChanged" AllowClear="true" />
                </RadzenStack>
            </div>
            <div class="grid2">
                <RadzenStack Gap="0.3rem" class="field">
                    <RadzenLabel Text="Plate" Component="cardPlate" />
                    <RadzenTextBox Name="cardPlate" id="cardPlate" Placeholder="1ABC234" Style="width:100%" class="plate-input" autocapitalize="characters" Immediate="true" Value="@ViewModel.Plate" ValueChanged="OnPlateChanged" />
                </RadzenStack>
                <RadzenStack Gap="0.3rem" class="field">
                    <RadzenLabel Text="Card number" Component="cardNumber" />
                    <RadzenTextBox Name="cardNumber" id="cardNumber" Placeholder="B000-000-000" Style="width:100%" @bind-Value="ViewModel.Number" />
                </RadzenStack>
            </div>
            <div id="tolBox">
                @if (ViewModel.Tolerances.Count > 0)
                {
                    <RadzenCheckBoxList TValue="string" Orientation="Orientation.Vertical" Value="ViewModel.SelectedTolerances" ValueChanged="OnTolerancesChanged">
                        <Items>
                            @foreach (var tolerance in ViewModel.Tolerances)
                            {
                                <RadzenCheckBoxListItem TValue="string" Value="tolerance.Code" Text="@tolerance.Label">
                                    <Template Context="box"><b>@tolerance.Label</b> <small>Only if your card shows the code <b>@tolerance.Code</b>. Not sure? Ask the City (02 279 22 11).</small></Template>
                                </RadzenCheckBoxListItem>
                            }
                        </Items>
                    </RadzenCheckBoxList>
                }
            </div>
            @if (!string.IsNullOrEmpty(ViewModel.FormError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" ShowIcon="false" role="alert">@ViewModel.FormError</RadzenAlert>
            }
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" class="muted small">Stored only on this phone.</RadzenText>
            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Save card" class="btn-block" Style="width:100%" />
        </RadzenStack>
    </RadzenTemplateForm>
</DialogShell>
