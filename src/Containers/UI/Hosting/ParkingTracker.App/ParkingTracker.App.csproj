<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The thin .NET MAUI Blazor Hybrid host (Android only). It builds only where the maui-android workload is installed
    (CI, see .github/workflows/android.yml), so it is not part of ParkingTracker.slnx (build this csproj directly).
    Build: dotnet publish -f net10.0-android -c Release [-p:EnableTestHooks=true] [-p:ApplicationVersion=N]
  -->
  <PropertyGroup>
    <!-- Directory.Build.props sets net10.0; the host is Android only. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ParkingTracker.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Parking Tracker</ApplicationTitle>
    <ApplicationId>be.parkingtracker.app</ApplicationId>
    <!-- CI sets both on the command line (-p:ApplicationVersion=..., -p:ApplicationDisplayVersion=...). -->
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <!-- .NET MAUI 10 supports Android 7.0 (API 24) and later; the Capacitor app supported API 23. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

  </PropertyGroup>

  <!-- Test hooks (window.ptTest): only a build made with -p:EnableTestHooks=true contains them. -->
  <PropertyGroup Condition="'$(EnableTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableTestHooks)' != 'true'">
    <Compile Remove="Features\Shared\TestHooks\**" />
  </ItemGroup>

  <!--
    Sign-in settings of the build, written into a generated constant (SignInConfiguration.g.cs) so that nothing is read at run time.
    GoogleWebClientId is the Web client ID of the Google project (not a secret). Debug and Release builds use the development project,
    whose Android clients hold the SHA-1 of the debug key and of the release key, until the production project exists (stage S9).
    Override on the command line with -p:GoogleWebClientId=... ; ApiBaseUrl is the address of the API.
  -->
  <PropertyGroup>
    <GoogleWebClientId Condition="'$(GoogleWebClientId)' == ''">1055999651780-ttrl5injs8ooc3dp84u67umpfcqgut49.apps.googleusercontent.com</GoogleWebClientId>
    <ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">https://api.parking.pivotsoftwares.com/</ApiBaseUrl>
  </PropertyGroup>
  <Target Name="GenerateSignInConfiguration" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <SignInConfigurationFile>$(IntermediateOutputPath)SignInConfiguration.g.cs</SignInConfigurationFile>
    </PropertyGroup>
    <ItemGroup>
      <SignInConfigurationLine Include="namespace ParkingTracker.App%3B" />
      <SignInConfigurationLine Include="internal static class SignInConfiguration" />
      <SignInConfigurationLine Include="{" />
      <SignInConfigurationLine Include="    internal const string GoogleWebClientId = &quot;$(GoogleWebClientId)&quot;%3B" />
      <SignInConfigurationLine Include="    internal const string ApiBaseUrl = &quot;$(ApiBaseUrl)&quot;%3B" />
      <SignInConfigurationLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(SignInConfigurationFile)" Lines="@(SignInConfigurationLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(SignInConfigurationFile)" />
      <FileWrites Include="$(SignInConfigurationFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\ParkingTracker.Application\ParkingTracker.Application.csproj" />
    <ProjectReference Include="..\..\..\..\Infrastructure\ParkingTracker.Infrastructure\ParkingTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\Infrastructure\ParkingTracker.Persistence.Device\ParkingTracker.Persistence.Device.csproj" />
    <ProjectReference Include="..\..\Core\ParkingTracker.ViewModels\ParkingTracker.ViewModels.csproj" />
    <ProjectReference Include="..\..\Core\ParkingTracker.Shared\ParkingTracker.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Xamarin.GooglePlayServices.Location" />
    <!-- Card photo text recognition on the device (ADR-0003). -->
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" />
    <!-- Google sign-in through Credential Manager (ADR-0014). -->
    <PackageReference Include="Xamarin.AndroidX.Credentials" />
    <PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" />
    <PackageReference Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" />
    <!-- Aligned with the AndroidX versions Play services Location brings, see Directory.Packages.props. -->
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
  </ItemGroup>


</Project>
