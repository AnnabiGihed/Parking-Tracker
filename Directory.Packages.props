<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <PivotFrameworkVersion>2.1.0</PivotFrameworkVersion>
  </PropertyGroup>

  <ItemGroup Label="Pivot.Framework (one family, pinned together)">
    <PackageVersion Include="Pivot.Framework.Domain" Version="$(PivotFrameworkVersion)" />
    <PackageVersion Include="Pivot.Framework.Application" Version="$(PivotFrameworkVersion)" />
    <PackageVersion Include="Pivot.Framework.Tools.DependencyInjection" Version="$(PivotFrameworkVersion)" />
    <PackageVersion Include="Pivot.Framework.Containers.API" Version="$(PivotFrameworkVersion)" />
    <PackageVersion Include="Pivot.Framework.Infrastructure.Persistence.PostgreSQL" Version="$(PivotFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup Label="Back end (ADR-0010, ADR-0016)">
    <!-- Same Npgsql provider line as Pivot.Framework.Infrastructure.Persistence.PostgreSQL 2.1.0 (10.0.3). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <!-- Pivot 2.1.0 brings EF Core 10.0.13 while the design-time package needs 10.0.15; pinned so the host loads one version (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- The generator Pivot.Framework.Authentication.AspNetCore 2.1.0 brings, declared because the API calls it. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup Label="Sign-in and API tokens (ADR-0014): the versions Pivot.Framework.Containers.API 2.1.0 already brings, declared because the API calls them">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup Label="Service defaults and local composition (Aspire, development only)">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!-- Not below the 1.20.1 Pivot.Framework.Containers.API 2.1.0 depends on. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (shared set, referenced in Directory.Build.props)">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>

  <ItemGroup Label="Validation (same version as the one Pivot.Framework.Application 2.1.0 depends on)">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup Label="Phone screens (ADR-0020)">
    <PackageVersion Include="Radzen.Blazor" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime (IHttpClientFactory for the live source clients)">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Device database (ADR-0026)">
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>

  <ItemGroup Label="MAUI host (ParkingTracker.App, Android only)">
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.130" />
    <PackageVersion Include="Xamarin.GooglePlayServices.Location" Version="121.4.0.1" />
    <PackageVersion Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
    <!-- Google sign-in through Credential Manager (ADR-0014); proven by the S5 spike. -->
    <PackageVersion Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
    <PackageVersion Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" Version="1.1.0.13" />
    <!-- Play services Location lifts the base AndroidX libraries; these AndroidX packages MAUI brings must follow them (NU1608). -->
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
  </ItemGroup>

</Project>
